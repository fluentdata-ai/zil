{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getzil.dev/spec/v1/manifest.schema.json",
  "title": "Zil Agent Manifest",
  "description": "Schema for Zil v1 agent manifest files.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "zil/v1",
      "description": "Manifest API version."
    },
    "kind": {
      "type": "string",
      "const": "Agent",
      "description": "Resource kind."
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "Agent name in kebab-case (3-64 chars)."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
          "description": "Semantic version (e.g. 1.0.0, 0.1.0-alpha)."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Short description of the agent."
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Arbitrary key-value labels."
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["runtime"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtime",
          "description": "Runtime configuration."
        },
        "identity": {
          "type": "string",
          "default": "./identity",
          "description": "Path to the root agent identity directory. Required unless spec.agents is present."
        },
        "agents": {
          "type": "array",
          "description": "Sub-agent definitions for multi-agent hierarchies.",
          "items": {
            "$ref": "#/$defs/agentSpec"
          },
          "minItems": 1
        },
        "skills": {
          "type": "string",
          "description": "Path to the skills directory."
        },
        "memory": {
          "type": "string",
          "description": "Path to the memory configuration."
        },
        "tools": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to the tools configuration directory."
            },
            {
              "$ref": "#/$defs/toolsConfig"
            }
          ],
          "description": "Tool and MCP server configuration (inline object or path to tools/ directory)."
        },
        "evals": {
          "type": "string",
          "description": "Path to the evals directory (contains config.yaml and suite files)."
        },
        "observability": {
          "type": "string",
          "description": "Path to the observability configuration."
        },
        "env": {
          "type": "array",
          "description": "Environment variables the agent requires at runtime.",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        },
        "cost": {
          "$ref": "#/$defs/cost",
          "description": "Token usage tracking and budget configuration."
        },
        "thinking_budget": {
          "type": "integer",
          "minimum": 0,
          "description": "Token budget for chain-of-thought thinking (Gemini extended thinking mode)."
        }
      }
    }
  },
  "$defs": {
    "envVar": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable name (UPPER_SNAKE_CASE)."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this variable is for."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Whether the variable must be set at deploy time."
        },
        "default": {
          "type": "string",
          "description": "Default value if not provided (only for non-required vars)."
        },
        "secret": {
          "type": "boolean",
          "default": false,
          "description": "Whether this variable contains sensitive data (masked in prompts)."
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard cap on tokens per LLM call. Requests exceeding this are blocked."
        },
        "max_tokens_per_session": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard cap on total tokens per agent session."
        },
        "alert_threshold_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Warn when session usage reaches this percentage of max_tokens_per_session."
        },
        "track_by_model": {
          "type": "boolean",
          "default": true,
          "description": "Break down token usage per model in metrics."
        }
      }
    },
    "toolsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_servers": {
          "type": "array",
          "description": "MCP servers the agent connects to.",
          "items": {
            "$ref": "#/$defs/mcpServer"
          }
        },
        "host_dependencies": {
          "type": "array",
          "description": "System packages required in the container (e.g. git, nodejs).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["name", "transport"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique identifier for this MCP server."
        },
        "transport": {
          "type": "string",
          "enum": ["stdio", "sse"],
          "description": "Connection transport type."
        },
        "command": {
          "type": "string",
          "description": "Command to start the MCP server process (stdio transport)."
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Arguments for the server command."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL of a remote MCP server (sse transport)."
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "HTTP headers for SSE connections."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables passed to the server process."
        },
        "tool_filter": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Expose only these tools (empty array or omitted = all tools)."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Connection timeout in seconds."
        },
        "source": {
          "type": "string",
          "description": "Path to MCP server source directory to bundle during pack/deploy."
        },
        "entry_point": {
          "type": "string",
          "description": "Entry point relative to source directory (e.g. dist/index.js, server.py). Used to resolve the bundled path at runtime."
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["framework", "language", "llm"],
      "additionalProperties": false,
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["adk", "a2a-supervisor", "openhands", "stub", "custom"],
          "default": "adk",
          "description": "Agent framework."
        },
        "framework_config": {
          "type": "object",
          "description": "Framework-specific configuration (e.g. sandbox, runtime options).",
          "additionalProperties": true
        },
        "language": {
          "type": "string",
          "enum": ["python", "typescript", "go"],
          "description": "Implementation language."
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(1[1-9]|[2-9][0-9])$",
          "description": "Python version (if language is python)."
        },
        "llm": {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": {
              "type": "string",
              "description": "Path to LLM adapter YAML."
            }
          }
        },
        "embedding": {
          "type": "object",
          "properties": {
            "adapter": {
              "type": "string",
              "description": "Path to embedding adapter YAML."
            }
          }
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "max_tokens_per_request": {
              "type": "integer",
              "minimum": 1
            },
            "max_duration_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        "service": {
          "$ref": "#/$defs/serviceConfig",
          "description": "HTTP service configuration (webhook entry-point and HITL)."
        },
        "dependencies": {
          "type": "array",
          "description": "Non-Python runtime dependencies installed in the container (e.g. Node.js, pnpm, gh CLI).",
          "items": {
            "$ref": "#/$defs/runtimeDependency"
          }
        }
      }
    },
    "runtimeDependency": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "description": "A single non-Python runtime dependency to install in the container.",
      "properties": {
        "name": {
          "type": "string",
          "description": "Package or tool name (e.g. pnpm, gh, nodejs)."
        },
        "type": {
          "type": "string",
          "enum": ["apt", "apt-nodesource", "apt-gh", "npm-global", "pip"],
          "description": "Install mechanism: apt=apt-get, apt-nodesource=NodeSource script, apt-gh=GitHub CLI repo, npm-global=npm install -g, pip=pip install."
        },
        "version": {
          "type": "string",
          "description": "Version pin (e.g. '20' for nodejs, '9.x' for pnpm, '1.2.3' for pip packages). Omit for latest."
        }
      }
    },
    "agentSpec": {
      "type": "object",
      "required": ["name", "identity"],
      "additionalProperties": false,
      "description": "Sub-agent definition in a multi-agent hierarchy.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique sub-agent identifier."
        },
        "role": {
          "type": "string",
          "enum": ["sub-agent", "supervisor", "peer"],
          "default": "sub-agent",
          "description": "Role in the agent hierarchy."
        },
        "identity": {
          "type": "string",
          "description": "Path to this sub-agent's identity directory (persona.md, instructions.md, optional guardrails.yaml)."
        },
        "llm": {
          "$ref": "#/$defs/agentLlm",
          "description": "LLM configuration for this sub-agent (overrides root adapter)."
        },
        "tools": {
          "$ref": "#/$defs/agentTools",
          "description": "Tool configuration for this sub-agent."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this sub-agent does (used as ADK agent description)."
        }
      }
    },
    "agentLlm": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-agent LLM configuration.",
      "properties": {
        "adapter": {
          "type": "string",
          "description": "Path to LLM adapter YAML (defaults to root spec.runtime.llm.adapter)."
        },
        "model_env_var": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable to override the model at runtime (e.g. AGENT_VTA_MODEL)."
        }
      }
    },
    "agentTools": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-agent tool configuration.",
      "properties": {
        "mcp_servers": {
          "type": "array",
          "description": "Names of MCP servers from spec.tools.mcp_servers to attach to this sub-agent.",
          "items": {
            "type": "string"
          }
        },
        "skills": {
          "type": "array",
          "description": "Skill names from spec.skills directory to expose to this sub-agent (allowlist). Omit to expose no skills.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "serviceConfig": {
      "type": "object",
      "additionalProperties": false,
      "description": "HTTP service entry-point configuration.",
      "properties": {
        "entry_point": {
          "type": "string",
          "enum": ["adk", "webhook", "custom"],
          "default": "adk",
          "description": "How the agent is triggered: 'adk' = ADK dev runner, 'webhook' = FastAPI HTTP service."
        },
        "webhooks": {
          "type": "array",
          "description": "Inbound webhook sources the agent accepts.",
          "items": {
            "$ref": "#/$defs/webhookSource"
          }
        },
        "human_interaction": {
          "$ref": "#/$defs/humanInteraction",
          "description": "Human-in-the-loop configuration."
        }
      }
    },
    "webhookSource": {
      "type": "object",
      "required": ["name", "path"],
      "additionalProperties": false,
      "description": "An inbound webhook source definition.",
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique webhook source identifier."
        },
        "path": {
          "type": "string",
          "description": "URL path for this webhook (e.g. /webhooks/jira)."
        },
        "signature_header": {
          "type": "string",
          "description": "HTTP header used for HMAC signature verification (e.g. X-Hub-Signature-256)."
        },
        "algorithm": {
          "type": "string",
          "enum": ["sha256", "sha1", "sha512"],
          "default": "sha256",
          "description": "HMAC algorithm used to verify the signature."
        },
        "secret_env": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable holding the webhook signing secret."
        },
        "events": {
          "type": "array",
          "description": "Event type filter (e.g. [jira:issue_created]). Empty = accept all.",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "humanInteraction": {
      "type": "object",
      "additionalProperties": false,
      "description": "Human-in-the-loop (HITL) configuration.",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable HITL support."
        },
        "response_path": {
          "type": "string",
          "default": "/human/respond",
          "description": "URL path for the human response endpoint."
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "default": 86400,
          "description": "Seconds to wait for a human response before triggering timeout_action."
        },
        "timeout_action": {
          "type": "string",
          "enum": ["abort", "proceed", "escalate"],
          "default": "abort",
          "description": "Action to take when timeout_seconds elapses without a human response."
        },
        "notify": {
          "type": "object",
          "additionalProperties": false,
          "description": "Notification channel used to reach the human when input is needed.",
          "properties": {
            "channel": {
              "type": "string",
              "enum": ["jira_comment", "slack", "http_callback"],
              "description": "Built-in notification channel."
            },
            "issue_key_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Env var holding the Jira issue key (required for jira_comment channel)."
            },
            "webhook_url_env": {
              "type": "string",
              "pattern": "^[A-Z][A-Z0-9_]*$",
              "description": "Env var holding the target URL (required for http_callback and slack channels)."
            }
          }
        }
      }
    }
  }
}
