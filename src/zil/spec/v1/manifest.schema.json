{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://getzil.dev/spec/v1/manifest.schema.json",
  "title": "Zil Agent Manifest",
  "description": "Schema for Zil v1 agent manifest files.",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "type": "string",
      "const": "zil/v1",
      "description": "Manifest API version."
    },
    "kind": {
      "type": "string",
      "const": "Agent",
      "description": "Resource kind."
    },
    "metadata": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,62}[a-z0-9]$",
          "description": "Agent name in kebab-case (3-64 chars)."
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(-[a-zA-Z0-9.]+)?(\\+[a-zA-Z0-9.]+)?$",
          "description": "Semantic version (e.g. 1.0.0, 0.1.0-alpha)."
        },
        "description": {
          "type": "string",
          "maxLength": 500,
          "description": "Short description of the agent."
        },
        "labels": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Arbitrary key-value labels."
        }
      }
    },
    "spec": {
      "type": "object",
      "required": ["runtime", "identity"],
      "additionalProperties": false,
      "properties": {
        "runtime": {
          "$ref": "#/$defs/runtime",
          "description": "Runtime configuration."
        },
        "identity": {
          "type": "string",
          "default": "./identity",
          "description": "Path to the identity directory."
        },
        "skills": {
          "type": "string",
          "description": "Path to the skills directory."
        },
        "memory": {
          "type": "string",
          "description": "Path to the memory configuration."
        },
        "tools": {
          "oneOf": [
            {
              "type": "string",
              "description": "Path to the tools configuration directory."
            },
            {
              "$ref": "#/$defs/toolsConfig"
            }
          ],
          "description": "Tool and MCP server configuration (inline object or path to tools/ directory)."
        },
        "evals": {
          "type": "string",
          "description": "Path to the evals directory (contains config.yaml and suite files)."
        },
        "observability": {
          "type": "string",
          "description": "Path to the observability configuration."
        },
        "env": {
          "type": "array",
          "description": "Environment variables the agent requires at runtime.",
          "items": {
            "$ref": "#/$defs/envVar"
          }
        },
        "cost": {
          "$ref": "#/$defs/cost",
          "description": "Token usage tracking and budget configuration."
        }
      }
    }
  },
  "$defs": {
    "envVar": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "description": "Environment variable name (UPPER_SNAKE_CASE)."
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of what this variable is for."
        },
        "required": {
          "type": "boolean",
          "default": true,
          "description": "Whether the variable must be set at deploy time."
        },
        "default": {
          "type": "string",
          "description": "Default value if not provided (only for non-required vars)."
        },
        "secret": {
          "type": "boolean",
          "default": false,
          "description": "Whether this variable contains sensitive data (masked in prompts)."
        }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens_per_request": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard cap on tokens per LLM call. Requests exceeding this are blocked."
        },
        "max_tokens_per_session": {
          "type": "integer",
          "minimum": 1,
          "description": "Hard cap on total tokens per agent session."
        },
        "alert_threshold_pct": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 80,
          "description": "Warn when session usage reaches this percentage of max_tokens_per_session."
        },
        "track_by_model": {
          "type": "boolean",
          "default": true,
          "description": "Break down token usage per model in metrics."
        }
      }
    },
    "toolsConfig": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mcp_servers": {
          "type": "array",
          "description": "MCP servers the agent connects to.",
          "items": {
            "$ref": "#/$defs/mcpServer"
          }
        },
        "host_dependencies": {
          "type": "array",
          "description": "System packages required in the container (e.g. git, nodejs).",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mcpServer": {
      "type": "object",
      "required": ["name", "transport"],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$",
          "description": "Unique identifier for this MCP server."
        },
        "transport": {
          "type": "string",
          "enum": ["stdio", "sse"],
          "description": "Connection transport type."
        },
        "command": {
          "type": "string",
          "description": "Command to start the MCP server process (stdio transport)."
        },
        "args": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Arguments for the server command."
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL of a remote MCP server (sse transport)."
        },
        "headers": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "HTTP headers for SSE connections."
        },
        "env": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Environment variables passed to the server process."
        },
        "tool_filter": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Expose only these tools (empty array or omitted = all tools)."
        },
        "timeout": {
          "type": "integer",
          "minimum": 1,
          "default": 10,
          "description": "Connection timeout in seconds."
        },
        "source": {
          "type": "string",
          "description": "Path to MCP server source directory to bundle during pack/deploy."
        },
        "entry_point": {
          "type": "string",
          "description": "Entry point relative to source directory (e.g. dist/index.js, server.py). Used to resolve the bundled path at runtime."
        }
      }
    },
    "runtime": {
      "type": "object",
      "required": ["framework", "language", "llm"],
      "additionalProperties": false,
      "properties": {
        "framework": {
          "type": "string",
          "enum": ["adk", "a2a-supervisor", "custom"],
          "default": "adk",
          "description": "Agent framework."
        },
        "language": {
          "type": "string",
          "enum": ["python", "typescript", "go"],
          "description": "Implementation language."
        },
        "python_version": {
          "type": "string",
          "pattern": "^3\\.(1[1-9]|[2-9][0-9])$",
          "description": "Python version (if language is python)."
        },
        "llm": {
          "type": "object",
          "required": ["adapter"],
          "properties": {
            "adapter": {
              "type": "string",
              "description": "Path to LLM adapter YAML."
            }
          }
        },
        "embedding": {
          "type": "object",
          "properties": {
            "adapter": {
              "type": "string",
              "description": "Path to embedding adapter YAML."
            }
          }
        },
        "resource_limits": {
          "type": "object",
          "properties": {
            "max_tokens_per_request": {
              "type": "integer",
              "minimum": 1
            },
            "max_duration_seconds": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    }
  }
}
