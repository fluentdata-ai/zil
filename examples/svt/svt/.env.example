# SVT Agent — environment variables
# Copy this file to .env and fill in your values before running locally.

# ── LLM API keys ──────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your-gemini-api-key
# ANTHROPIC_API_KEY=sk-ant-...

# ── Model overrides (optional — defaults used if unset) ───────────────────────
# AGENT_VTL_MODEL=gemini-2.5-flash
# AGENT_VTA_MODEL=gemini-2.5-pro
# AGENT_VTD_MODEL=anthropic/claude-sonnet-4-20250514

# ── GitHub ────────────────────────────────────────────────────────────────────
GITHUB_REPO_URL=https://github.com/your-org/your-repo
GITHUB_DEFAULT_BASE_BRANCH=dev
GITHUB_TOKEN=ghp_your-github-pat

# ── Jira ──────────────────────────────────────────────────────────────────────
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_WEBHOOK_SECRET=change-me-before-production

# ── Jira MCP server ───────────────────────────────────────────────────────────
JIRA_MCP_COMMAND=uvx
JIRA_API_TOKEN=your-atlassian-api-token
JIRA_USER_EMAIL=you@your-org.com

# ── Agent behaviour ───────────────────────────────────────────────────────────
# plan_only | plan_and_execute
AGENT_MODE=plan_only
# AGENT_WORKSPACE_ROOT=/tmp/workspaces

# ── Local dev workspace (used by zil web / ADK dev UI only) ──────────────────
# Filesystem tools read/write here instead of a cloned repo.
# DEV_WORKSPACE=/tmp/svt-dev-workspace

# ── Session storage ───────────────────────────────────────────────────────────
# Leave unset for SQLite (local dev). Use postgresql+pg8000://... in prod.
# SESSION_DB_URI=sqlite+aiosqlite:///./sessions.db

# ── Debug endpoint (optional — leave unset to disable /debug/run-task) ────────
# DEBUG_TOKEN=some-random-token

# ── Observability ─────────────────────────────────────────────────────────────
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://localhost:4318/v1/traces
